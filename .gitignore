

# Environment variables
.env

# Virtual environment
venv/
venv-linux/

# Google Drive credentials (ignore all JSON files inside)
gdrive_credentials/*.json

# Node modules
node_modules/

# Collected static (regenerated by collectstatic on every deploy — never commit)
staticfiles/

# NOTE: static/css/output.css (compiled Tailwind for the main app) is intentionally
# committed. On this Railway setup the build-phase `npm run build:css` output does not
# reach the serving container, so committing it guarantees the main app's CSS is present
# and collected. Re-run `npm run build:css` and commit when main-app Tailwind classes change.

# Celery
celerybeat-schedule*
celerybeat-schedule-shm
celerybeat-schedule-wal
celerybeat.pid